{
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "workbench.colorTheme": "Default Light Modern",
    "editor.wordWrap": "on",
    "editor.scrollbar.verticalScrollbarSize": 10,
    "workbench.activityBar.orientation": "vertical",
    "typescript.experimental.useTsgo": true,
    "editor.stickyScroll.enabled": false,
    "workbench.tree.indent": 18,
    "workbench.tree.expandMode": "doubleClick",
    "workbench.tree.enableStickyScroll": false,
    "editor.fontFamily": "JetBrainsMono-Medium",
    "workbench.iconTheme": "material-icon-theme",
    "window.newWindowDimensions": "maximized",
    "explorer.autoReveal": false,
    "workbench.editor.enablePreview": false,
    "workbench.editor.decorations.badges": false,
    "workbench.editor.decorations.colors": true,
    "problems.visibility": true,
    "problems.decorations.enabled": false,
    "git.decorations.enabled": true,
    "workbench.colorCustomizations": {
        "gitDecoration.modifiedResourceForeground": "#0078d4",
        "gitDecoration.stageModifiedResourceForeground": "#0078d4",
        "tab.activeModifiedBorder": "#0078d4",
        "tab.inactiveModifiedBorder": "#0078d4cc",
        "tab.unfocusedActiveModifiedBorder": "#0078d4b3",
        "tab.unfocusedInactiveModifiedBorder": "#0078d466"
    },
    "editor.scrollBeyondLastLine": false,
    "window.zoomLevel": 0.7,
    "gitlens.currentLine.enabled": false,
    "gitlens.codeLens.enabled": false
}
